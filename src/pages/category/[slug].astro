---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import CategoryHero from '../../components/CategoryHero.astro';
import SubtypeEntries from '../../components/SubtypeEntries.astro';
import ProductList from '../../components/ProductList.astro';
import { type Category, categories, getProductsByCategory } from '../../lib/data';
import { getPublishedArticles } from '../../lib/articles';

export function getStaticPaths() {
  return categories.map((category) => ({ params: { slug: category.slug }, props: { category } }));
}

interface Props { category: Category }
const { category } = Astro.props;

const articles = (await getPublishedArticles())
  .filter((a) => a.data.category === category.slug)
  .sort((a, b) => Number(b.data.pinned) - Number(a.data.pinned));
const items = getProductsByCategory(category.slug);

const jsonLd = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: '首頁', item: Astro.site?.href },
    { '@type': 'ListItem', position: 2, name: category.name, item: new URL(Astro.url.pathname, Astro.site).href },
  ],
};
---
<BaseLayout title={category.kind === 'guide' ? `${category.name}介紹` : `${category.name}推薦與選購指南`} description={category.heroSubtitle ?? category.description} jsonLd={jsonLd}>
  <CategoryHero
    title={category.heroTitle ?? `${category.name}推薦與比較`}
    subtitle={category.heroSubtitle ?? category.description}
    crumbs={[{ name: '首頁', href: '/' }, { name: category.name }]}
  />

  <div class="container">
    {category.kind !== 'guide' && (
      <>
        <SubtypeEntries category={category} products={items} />
        <ProductList category={category} products={items} title={`${category.name}推薦`} />
      </>
    )}

    {articles.length > 0 && (
      <section aria-labelledby="articles-heading">
        <h2 id="articles-heading">{category.kind === 'guide' ? `${category.name}文章` : `${category.name}選購文章`}</h2>
        <div class="grid">{articles.map((a) => <ArticleCard article={a} />)}</div>
      </section>
    )}
  </div>
</BaseLayout>
