---
import { render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductCompare from '../../components/ProductCompare.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import AuthorBox from '../../components/AuthorBox.astro';
import { authorAvatar, getAuthor, getCategory } from '../../lib/data';
import { getPublishedArticles } from '../../lib/articles';

export async function getStaticPaths() {
  const articles = await getPublishedArticles();
  return articles.map((article) => ({ params: { slug: article.id }, props: { article } }));
}

interface Props { article: CollectionEntry<'articles'> }
const { article } = Astro.props;
const { Content } = await render(article);
const { title, description, pubDate, updatedDate, products: productIds, sources } = article.data;
const author = getAuthor(article.data.author);
const authorUrl = new URL(`/author/${author.id}/`, Astro.site).href;
const category = getCategory(article.data.category)!;

const related = (await getPublishedArticles())
  .filter((a) => a.data.category === article.data.category && a.id !== article.id)
  .slice(0, 3);

const fmt = (d: Date) => d.toLocaleDateString('zh-TW', { year: 'numeric', month: 'long', day: 'numeric' });
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;

const jsonLd = [
  {
    '@type': 'Article',
    headline: title,
    description,
    datePublished: pubDate.toISOString(),
    dateModified: (updatedDate ?? pubDate).toISOString(),
    inLanguage: 'zh-Hant-TW',
    mainEntityOfPage: pageUrl,
    author: { '@type': 'Person', name: author.name, url: authorUrl, jobTitle: author.role },
    publisher: { '@type': 'Organization', name: 'Mewtelligence' },
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: '首頁', item: Astro.site?.href },
      { '@type': 'ListItem', position: 2, name: category.name, item: new URL(`/category/${category.slug}/`, Astro.site).href },
      { '@type': 'ListItem', position: 3, name: title, item: pageUrl },
    ],
  },
];
---
<BaseLayout
  title={title}
  description={description}
  type="article"
  publishedTime={pubDate}
  modifiedTime={updatedDate}
  jsonLd={jsonLd}
>
  <article class="container article">
    <nav class="crumbs" aria-label="麵包屑">
      <a href="/">首頁</a> › <a href={`/category/${category.slug}/`}>{category.name}</a>
    </nav>
    <header>
      <a class="tag" href={`/category/${category.slug}/`}>{category.name}</a>
      <h1>{title}</h1>
      <p class="meta">
        <a class="byline" href={`/author/${author.id}/`}>
          <img src={authorAvatar(author)} alt="" width="24" height="24" />文／{author.name}
        </a>
        ·
        <time datetime={pubDate.toISOString()}>{fmt(pubDate)}</time>
        {updatedDate && <> · 更新於 <time datetime={updatedDate.toISOString()}>{fmt(updatedDate)}</time></>}
      </p>
      {productIds.length > 0 && (
        <p class="disclosure">本文含聯盟行銷連結，透過連結購買不會增加你的費用，Mewtelligence 可能獲得分潤。</p>
      )}
    </header>

    <div class="prose">
      <Content />
    </div>

    <ProductCompare ids={productIds} />

    {sources.length > 0 && (
      <section class="sources" aria-labelledby="sources-heading">
        <h2 id="sources-heading">參考資料</h2>
        <ol>
          {sources.map((s) => (
            <li><a href={s.url} rel="noopener" target="_blank">{s.title}</a></li>
          ))}
        </ol>
      </section>
    )}

    <AuthorBox author={author} />
  </article>

  {related.length > 0 && (
    <section class="container" aria-labelledby="related-heading">
      <h2 id="related-heading">延伸閱讀</h2>
      <div class="grid">{related.map((a) => <ArticleCard article={a} />)}</div>
    </section>
  )}
</BaseLayout>

<style>
  .article { padding-top: 28px; max-width: 820px; }
  .crumbs { font-size: 0.85rem; color: var(--cd-text-muted); margin-bottom: 12px; }
  header h1 { margin: 12px 0 8px; }
  .meta { color: var(--cd-text-muted); font-size: 0.88rem; margin: 0 0 16px; display: flex; flex-wrap: wrap; align-items: center; gap: 6px; }
  .byline { display: inline-flex; align-items: center; gap: 6px; color: var(--cd-text); font-weight: 700; text-decoration: none; }
  .byline img { border-radius: 50%; background: var(--cd-primary-soft); padding: 2px; }
  .sources { font-size: 0.9rem; }
  .sources h2 { font-size: 1.1rem; }
  .sources ol { padding-left: 1.4em; color: var(--cd-text-muted); }
  .prose { font-size: 1.05rem; }
  .prose :global(h2) { padding-left: 12px; border-left: 5px solid var(--cd-primary); }
  .prose :global(blockquote) {
    margin: 1.5em 0;
    padding: 12px 18px;
    background: var(--cd-primary-soft);
    border-radius: var(--cd-radius-sm);
  }
  .prose :global(blockquote p) { margin: 0; }
  .prose :global(li) { margin: 0.3em 0; }
  .prose :global(table) {
    display: block; max-width: 100%; overflow-x: auto;
    border-collapse: collapse; margin: 1em 0; font-size: 0.95rem; line-height: 1.6;
  }
  .prose :global(th), .prose :global(td) { padding: 8px 14px; border: 1px solid var(--cd-border); text-align: left; vertical-align: top; }
  .prose :global(thead th) { background: var(--cd-primary-soft); white-space: nowrap; }
  .prose :global(tbody tr:nth-child(even)) { background: var(--cd-surface-alt); }
  .prose :global(h3) { margin-top: 1.6em; }
  .prose :global(img) { display: block; width: 100%; height: auto; border-radius: var(--cd-radius); margin: 0.5em 0 0.2em; }
  .prose :global(img + em) { display: block; text-align: center; font-size: 0.85rem; color: var(--cd-text-muted); }
</style>
