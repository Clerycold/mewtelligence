---
import { render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductCompare from '../../components/ProductCompare.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getCategory } from '../../lib/data';
import { getPublishedArticles } from '../../lib/articles';

export async function getStaticPaths() {
  const articles = await getPublishedArticles();
  return articles.map((article) => ({ params: { slug: article.id }, props: { article } }));
}

interface Props { article: CollectionEntry<'articles'> }
const { article } = Astro.props;
const { Content } = await render(article);
const { title, description, pubDate, updatedDate, products: productIds } = article.data;
const category = getCategory(article.data.category)!;

const related = (await getPublishedArticles())
  .filter((a) => a.data.category === article.data.category && a.id !== article.id)
  .slice(0, 3);

const fmt = (d: Date) => d.toLocaleDateString('zh-TW', { year: 'numeric', month: 'long', day: 'numeric' });
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;

const jsonLd = [
  {
    '@type': 'Article',
    headline: title,
    description,
    datePublished: pubDate.toISOString(),
    dateModified: (updatedDate ?? pubDate).toISOString(),
    inLanguage: 'zh-Hant-TW',
    mainEntityOfPage: pageUrl,
    author: { '@type': 'Organization', name: 'Mewtelligence 編輯部' },
    publisher: { '@type': 'Organization', name: 'Mewtelligence' },
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: '首頁', item: Astro.site?.href },
      { '@type': 'ListItem', position: 2, name: category.name, item: new URL(`/category/${category.slug}/`, Astro.site).href },
      { '@type': 'ListItem', position: 3, name: title, item: pageUrl },
    ],
  },
];
---
<BaseLayout
  title={title}
  description={description}
  type="article"
  publishedTime={pubDate}
  modifiedTime={updatedDate}
  jsonLd={jsonLd}
>
  <article class="container article">
    <nav class="crumbs" aria-label="麵包屑">
      <a href="/">首頁</a> › <a href={`/category/${category.slug}/`}>{category.name}</a>
    </nav>
    <header>
      <a class="tag" href={`/category/${category.slug}/`}>{category.name}</a>
      <h1>{title}</h1>
      <p class="meta">
        <time datetime={pubDate.toISOString()}>{fmt(pubDate)}</time>
        {updatedDate && <> · 更新於 <time datetime={updatedDate.toISOString()}>{fmt(updatedDate)}</time></>}
      </p>
      {productIds.length > 0 && (
        <p class="disclosure">本文含聯盟行銷連結，透過連結購買不會增加你的費用，Mewtelligence 可能獲得分潤。</p>
      )}
    </header>

    <div class="prose">
      <Content />
    </div>

    <ProductCompare ids={productIds} />
  </article>

  {related.length > 0 && (
    <section class="container" aria-labelledby="related-heading">
      <h2 id="related-heading">延伸閱讀</h2>
      <div class="grid">{related.map((a) => <ArticleCard article={a} />)}</div>
    </section>
  )}
</BaseLayout>

<style>
  .article { padding-top: 28px; max-width: 820px; }
  .crumbs { font-size: 0.85rem; color: var(--cd-text-muted); margin-bottom: 12px; }
  header h1 { margin: 12px 0 8px; }
  .meta { color: var(--cd-text-muted); font-size: 0.88rem; margin: 0 0 16px; }
  .prose { font-size: 1.05rem; }
  .prose :global(h2) { padding-left: 12px; border-left: 5px solid var(--cd-primary); }
  .prose :global(blockquote) {
    margin: 1.5em 0;
    padding: 12px 18px;
    background: var(--cd-primary-soft);
    border-radius: var(--cd-radius-sm);
  }
  .prose :global(blockquote p) { margin: 0; }
  .prose :global(li) { margin: 0.3em 0; }
</style>
