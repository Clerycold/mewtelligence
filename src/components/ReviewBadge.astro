---
import { type Product, REVIEW_TYPE_LABEL } from '../lib/data';

interface Props { type: Product['reviewType'] }
const { type } = Astro.props;
const title = type === 'hands-on' ? '作者家的貓實際使用過' : '依官方規格與公開資料整理，未實際使用';
---
<a class:list={['review-badge', `review-badge--${type}`]} href="/how-we-review/" title={title}>
  {type === 'hands-on' ? '✓ ' : ''}{REVIEW_TYPE_LABEL[type]}
</a>

<style>
  .review-badge {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 700;
    padding: 0.1em 0.6em;
    border-radius: 999px;
    text-decoration: none;
    white-space: nowrap;
    border: 1px solid;
  }
  .review-badge--hands-on { color: var(--cd-accent); border-color: var(--cd-accent); background: #eef5f1; }
  .review-badge--research { color: var(--cd-text-muted); border-color: var(--cd-border); background: var(--cd-surface); }
</style>
