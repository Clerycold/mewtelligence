---
/** 一般說明頁（關於我們、隱私權政策等）的版型 */
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  updated?: Date;
}
const { title, description, updated } = Astro.props;
const fmt = (d: Date) => d.toLocaleDateString('zh-TW', { year: 'numeric', month: 'long', day: 'numeric' });
---
<BaseLayout title={title} description={description}>
  <article class="container page">
    <nav class="crumbs" aria-label="麵包屑"><a href="/">首頁</a> › {title}</nav>
    <h1>{title}</h1>
    {updated && <p class="meta">最後更新：<time datetime={updated.toISOString()}>{fmt(updated)}</time></p>}
    <div class="prose">
      <slot />
    </div>
  </article>
</BaseLayout>

<style>
  .page { padding-top: 28px; max-width: 820px; }
  .crumbs { font-size: 0.85rem; color: var(--cd-text-muted); margin-bottom: 12px; }
  .meta { color: var(--cd-text-muted); font-size: 0.88rem; margin: 0 0 24px; }
  .prose { font-size: 1.02rem; }
  .prose :global(h2) { padding-left: 12px; border-left: 5px solid var(--cd-primary); }
  .prose :global(li) { margin: 0.3em 0; }
</style>
